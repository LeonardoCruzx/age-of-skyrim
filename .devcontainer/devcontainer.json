{
  "name": "Age of Skyrim (Claude pessoal)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/AgeOfSkyrim",
  "remoteUser": "vscode",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "llvm-vs-code-extensions.vscode-clangd",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": false,
        "clangd.arguments": ["--header-insertion=never", "--log=error"]
      }
    }
  }
}
