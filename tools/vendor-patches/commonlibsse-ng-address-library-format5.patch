+	bool IDDatabase::load_v5(istream_t &a_in, header_v5_t a_header, Version a_version, bool a_failOnError)
+	{
+		if (a_header.version() != a_version) {
+			return stl::report_and_error("version mismatch"sv, a_failOnError);
+		}
+
+		// O arquivo guarda um array denso (indice = id, 0 = sem mapeamento). Gravamos
+		// {id, offset} indexado pelo proprio id (slots[id] = {id, ...}) em vez de pular
+		// os zeros: assim o span tem sempre exatamente denseCount entradas, ja ordenado
+		// por id (indice crescente = id crescente, sem precisar reordenar), e o tamanho
+		// bate tanto na primeira carga quanto ao reabrir essa mesma memoria compartilhada
+		// de outro plugin que ja tenha processado o mesmo arquivo. offset 0 continua
+		// significando "sem mapeamento" — tratado em id2offset() via _isDenseFormat5, nao
+		// filtrado aqui.
+		const auto denseCount = a_header.offset_count();
+
+		auto mapname = L"CommonLibSSEOffsetsV5-"s;
+		mapname += a_version.wstring();
+		const auto byteSize = static_cast<std::size_t>(denseCount) * sizeof(mapping_t);
+		if (_mmap.open(mapname, byteSize)) {
+			_id2offset = { static_cast<mapping_t*>(_mmap.data()), denseCount };
+			_isDenseFormat5 = true;
+			return true;
+		}
+		if (!_mmap.create(mapname, byteSize)) {
+			return stl::report_and_error("failed to create shared mapping"sv, a_failOnError);
+		}
+
+		auto* slots = static_cast<mapping_t*>(_mmap.data());
+		for (std::uint64_t id = 0; id < denseCount; ++id) {
+			slots[id] = { id, static_cast<std::uint64_t>(a_in.readout<std::uint32_t>()) };
+		}
+		_id2offset = { slots, denseCount };
+		_isDenseFormat5 = true;
+
+		return true;
+	}
+
