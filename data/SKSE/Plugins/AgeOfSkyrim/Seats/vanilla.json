{
  // Candidatas a sede da facção (M6, ADR 0023). Outros mods podem adicionar arquivos nesta pasta.
  //
  // "auto": em cada província (Hold), os N fortes/torres mais próximos da cidade da província viram candidatos.
  //   Funciona com qualquer mod de locais (usa os territórios descobertos), sem FormIDs fixos.
  // "candidates": lista explícita, por território do JSON ou por BGSLocation, com offsets opcionais:
  //   { "territory": "meu_forte" }
  //   { "location": "Skyrim.esm|0x0ABCDE", "chestOffset": [-100, 150, 0], "warTableOffset": [120, 220, 0] }
  // "exclude": tira candidatos (de qualquer arquivo já lido): [ "Skyrim.esm|0x0ABCDE", "meu_forte" ].
  // A lista completa de territórios (com os IDs de location) sai em SKSE/AgeOfSkyrim_territories.json (debug ligado).
  "auto": { "types": ["fort", "tower"], "perProvince": 2 },
  "candidates": [
    { "territory": "test_tower" }
  ],
  "exclude": []
}
