{
  // População numérica por território (M19), sem atores. Outros mods podem soltar mais *.json nesta pasta.
  "population": {
    // Inicial por tipo de território ("unknown" = sem tipo; "claim" e "house" também aceitos, padrão 5/20).
    // Teto = inicial × capacityFactor.
    "initial": { "camp": 25, "fort": 60, "tower": 15, "village": 120, "city": 800, "unknown": 10 },
    // Por território (id do território): { "whiterun_city": 1200 }
    "territories": {},
    "capacityFactor": 2.0,
    "growthPerDay": 0.03,     // crescimento logístico com comida (fração por dia)
    "starvationPerDay": 0.05, // queda sem comida (fração por dia)
    "captureLoss": 0.15,      // perda ao trocar de dono (guerra)
    "draftReserve": 0.25,     // alistamento nunca desce abaixo desta fração da inicial
    "manpowerMin": 0.5,       // multiplicador de produção por mão de obra = população / inicial, nesses limites
    "manpowerMax": 1.5
  }
}
