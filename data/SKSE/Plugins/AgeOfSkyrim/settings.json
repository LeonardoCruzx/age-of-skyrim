{
  // "en", "pt-br" ou "auto" (idioma do jogo). textEncoding: "utf8" ou "cp1252" (se acentos aparecerem errados).
  "language": "pt-br",
  "textEncoding": "utf8",
  // Free Claim: objeto do estandarte (padrão: Iron Sword "fincada"), distância mínima entre claims
  // (unidades do jogo; 70 ≈ 1 m), máximo de claims, inclinação máxima do terreno e distância à frente.
  "claim": {
    "banner": "Skyrim.esm|0x012EB7",
    "minDistance": 2048,
    "maxClaims": 10,
    "maxSlopeDegrees": 35,
    "forwardDistance": 150
  },
  // Territórios descobertos dos locais do jogo (vanilla + mods) pelas keywords LocType*.
  // types: "fort", "camp", "village", "city" ("tower" só via JSON). exclude: ["Plugin.esp|0xID", ...].
  "discovery": {
    "enabled": true,
    "types": ["fort", "camp", "village", "city"],
    "exclude": [],
    "neighbors": 4
  },
  // Reino (M18/M19/M22): horas de jogo entre trocas de doutrina (a 1ª escolha é livre) e anúncio de títulos.
  // Doutrinas/cargos/governadores em Doctrines/*.json, população em Population/*.json, títulos em Titles/*.json.
  "realm": {
    "doctrineCooldownHours": 168,
    "announceTitles": true
  },
  // realm*Hotkey (DIK): F7 resumo do reino, F6 simula realmDebugHours horas, F3 próxima doutrina,
  // F4 entrega os realmConquerCount territórios mais próximos à facção do jogador.
  "debug": {
    "enabled": true,
    "hotkey": 68,
    "selfTestHotkey": 87,
    "stockHotkey": 66,
    "claimHotkey": 67,
    "realmHotkey": 65,
    "realmHoursHotkey": 64,
    "realmDoctrineHotkey": 61,
    "realmConquerHotkey": 62,
    "realmDebugHours": 24,
    "realmConquerCount": 5,
    "territory": "test_tower"
  }
}
