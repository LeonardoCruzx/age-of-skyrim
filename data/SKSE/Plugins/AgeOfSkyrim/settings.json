{
  // "en", "pt-br" ou "auto" (idioma do jogo). textEncoding: "utf8" ou "cp1252" (se acentos aparecerem errados).
  "language": "pt-br",
  "textEncoding": "utf8",
  // Free Claim: objeto do estandarte (padrão: Iron Sword "fincada"), distância mínima entre claims
  // (unidades do jogo; 70 ≈ 1 m), máximo de claims, inclinação máxima do terreno e distância à frente.
  "claim": {
    "banner": "Skyrim.esm|0x012EB7",
    "minDistance": 2048,
    "maxClaims": 10,
    "maxSlopeDegrees": 35,
    "forwardDistance": 150
  },
  // Territórios descobertos dos locais do jogo (vanilla + mods) pelas keywords LocType*.
  // types: "fort", "camp", "village", "city", "house" ("tower" só via JSON). exclude: ["Plugin.esp|0xID", ...].
  // "house" (M29, LocTypePlayerHouse): casas do jogador (ex.: Lakeview Manor); as que ficam dentro de uma
  // cidade saem sozinhas (a cidade já é candidata do tipo "city" — ver Discovery::Scan, remoção de sub-locais).
  "discovery": {
    "enabled": true,
    "types": ["fort", "camp", "village", "city", "house"],
    "exclude": [],
    "neighbors": 4
  },
  // ---- M5: conquista por local limpo (ADR 0022) ----
  // requirePlayerInLocation: false = vale também o local de onde o jogador acabou de sair.
  // onlyFromNeutral: true = não toma locais que já têm dono (ex.: deixar a Guerra Civil com outro mod).
  // exclude: ["Plugin.esp|0xID" (BGSLocation) ou "id_do_territorio"]; excludePlugins: ["MeuModDeGuerra.esp"].
  // defaultStyle/defaultColor: facção criada na primeira conquista se você ainda não tem uma ("" = automático).
  // M16: "skipCivilWarForts": true deixa os fortes da Guerra Civil de fora (também ligado pelo patch civil-war-mods;
  // se definido aqui, vence o patch).
  "conquest": {
    "enabled": true,
    "requirePlayerInLocation": true,
    "onlyFromNeutral": false,
    "exclude": [],
    "excludePlugins": [],
    "defaultStyle": "",
    "defaultColor": "#2E7D32"
  },
  // ---- M6: sede da facção (ADR 0023) ----
  // chest / warTable: "auto" (o DLL escolhe um baú vanilla SEM respawn e um ativador de mesa) ou "Plugin.esp|0xID".
  // Offsets [direita, frente, cima] relativos ao jogador no momento da fundação (sem coordenadas curadas ainda).
  "seat": {
    "askBeforeFounding": true,
    "chest": "auto",
    "warTable": "auto",
    "chestOffset": [-100, 150, 0],
    "warTableOffset": [120, 220, 0]
  },
  // Reino (M18/M19/M22): horas de jogo entre trocas de doutrina (a 1ª escolha é livre) e anúncio de títulos.
  // Doutrinas/cargos/governadores em Doctrines/*.json, população em Population/*.json, títulos em Titles/*.json.
  // dominationThreshold (M27, ADR 0057): fração de províncias com maioria para "Dominador(a) de Skyrim" (1 = todas).
  "realm": {
    "doctrineCooldownHours": 168,
    "announceTitles": true,
    "dominationThreshold": 1.0
  },
  // ---- M24: governo local / presença na capital da província (ADR 0056) ----
  // askBeforeAssign: pergunta (MessageBox) antes de colocar o governador ao conquistar a capital.
  // actor/outfit: "auto" (o DLL escolhe um NPC não-único do Skyrim.esm) ou "Plugin.esp|0xID"/EditorID.
  // autoHint: dica no modelo do outfit padrão para a escolha automática ("noble" = roupas nobres vanilla).
  // offset: [direita, frente, cima] relativo ao marcador da capital.
  "jarl": {
    "askBeforeAssign": true,
    "actor": "auto",
    "outfit": "auto",
    "autoHint": "noble",
    "offset": [0, 150, 0]
  },
  // Integração com outros mods (API C++ e Papyrus, ADR 0032): papyrusEvents = ModEvents "AoS_*" para scripts;
  // allowOwnerChanges = outros mods podem trocar o dono de territórios.
  "api": {
    "papyrusEvents": true,
    "allowOwnerChanges": true
  },
  // ---- M11: mesa de guerra / mapa tático (ADR 0051-0054) ----
  // usePrismaUI: usa a view HTML se o PrismaUI estiver instalado (senão, ou com false, menus vanilla).
  // view: relativo a Data/PrismaUI/views/. pageSize: territórios por página nos menus vanilla (1-7).
  // nearbyRadius: raio da lista "Territórios próximos" (unidades do jogo; 0 = todos). maxTargets: alvos marcados.
  "warMap": {
    "enabled": true,
    "usePrismaUI": true,
    "view": "AgeOfSkyrim/index.html",
    "pauseGame": true,
    "pageSize": 6,
    "nearbyRadius": 60000,
    "maxTargets": 10
  },
  // ---- M14: guarnição (ADR 0043) ----
  // Soldados só viram atores perto do jogador: marcador do território numa célula carregada e a até spawnRadius
  // unidades (70 ≈ 1 m). maxActors = teto GLOBAL de soldados vivos; spawnPerFrame = criados por frame.
  // enabled: false = só números (nenhum ator). Números, tropas e manutenção em Garrison.json.
  "garrison": {
    "enabled": true,
    "maxActors": 12,
    "spawnPerFrame": 2,
    "spawnRadius": 8192,
    "spreadRadius": 256
  },
  // ---- M16: facções de IA e contra-ataques (ADR 0047/0048) ----
  // tickHours: horas de jogo entre avaliações. A IA ataca vizinhos de facções em GUERRA com ela (diplomacia) e,
  // com expandIntoNeutral, territórios neutros dos expandTypes. Força do ataque = attackBase + ouro gasto /
  // goldPerStrength (gasta entre minGoldPerAttack e maxGoldPerAttack do saldo da facção); só lança se a força
  // >= defesa × minAdvantage. Defesa padrão por tipo (defenseByType; neutro × neutralDefenseMultiplier).
  // Marcha: hoursPer10000Units (70 unidades ≈ 1 m), entre minTravelHours e maxTravelHours.
  // respectConquestExclusions: a IA também não toca nos locais excluídos da conquista (settings + Compat/*.json).
  // skipCivilWarForts: fortes militares da Guerra Civil vanilla nunca são alvo da IA (também via Compat/*.json,
  // bloco "ai"; o valor daqui, se presente, vence o dos patches — por isso vem comentado).
  "ai": {
    "enabled": true,
    "tickHours": 6,
    "maxEvaluationsPerTick": 512,
    "maxActiveAttacks": 8,
    "maxAttacksPerFaction": 2,
    "cooldownHours": 24,
    "attackBase": 20,
    "goldPerStrength": 10,
    "minGoldPerAttack": 50,
    "maxGoldPerAttack": 500,
    "minAdvantage": 1.2,
    "randomness": 0.2,
    "hoursPer10000Units": 2,
    "minTravelHours": 2,
    "maxTravelHours": 48,
    "nearPlayerRadius": 8192,
    "attackPlayer": true,
    "expandIntoNeutral": true,
    "expandTypes": ["fort", "village", "city"],
    "neutralDefenseMultiplier": 0.5,
    "declareWarRatio": 2.0,
    "respectConquestExclusions": true,
    // "skipCivilWarForts": false,
    "defenseByType": { "fort": 40, "tower": 25, "camp": 15, "village": 15, "city": 60, "claim": 10, "unknown": 15 }
  },
  // ---- M17: diplomacia (ADR 0049) ----
  // Paz aceita depois de guerra = trégua de truceHours horas (sem guerra), depois paz. A IA aceita a paz se o
  // poder dela < o seu × peaceAcceptRatio (ou se está em déficit); aliança se você tem poder >= o dela ×
  // allianceAcceptRatio (e, com allianceNeedsCommonEnemy, um inimigo em comum). warOnConquest: tomar um território
  // de uma facção de IA que não está em guerra com você faz ela declarar guerra.
  "diplomacy": {
    "truceHours": 72,
    "peaceAcceptRatio": 1.5,
    "allianceAcceptRatio": 0.75,
    "allianceNeedsCommonEnemy": true,
    "warOnConquest": true
  },
  // ---- M25: lei e prisioneiros de guerra (ADR 0060/0061) ----
  // touchCrimeFaction: interruptor mestre (default false = nunca toca a facção de crime vanilla do Hold, para
  // compatibilidade com mods de Guerra Civil/lei, ADR 0005); resetBounty só tem efeito com ele ligado.
  // captureFraction: fração dos soldados derrotados num combate (M16) que vira prisioneiro do vencedor, até
  // a capacidade (baseCapacityPerTerritory por território + melhoria "prison" do Upgrades.json).
  // ransomCostPerPrisoner: ouro por prisioneiro resgatado (itens reais do baú da sede; numérico para a IA).
  "law": {
    "touchCrimeFaction": false,
    "resetBounty": true,
    "captureFraction": 0.5,
    "baseCapacityPerTerritory": 3,
    "ransomCostPerPrisoner": 50,
    "debugCaptureCount": 3
  },
  // ---- M26: ordem pública e rebeliões (ADR 0062/0063) ----
  // Estabilidade (0-100) por território: baseline × doutrina/governador (Realm::Modifiers), menos penalidade de
  // guarnição insuficiente para a população (popToStrength) e de déficit de comida OU ouro (deficitPenalty).
  // Abaixo de rebellionThreshold por graceHours horas seguidas, chancePerHour por hora de rebelião: vira a
  // facção "rebels" (Factions/rebels.json) se rebelFaction, senão neutro. unrestDecayPerHour: quanto o abalo de
  // uma execução (Law::Execute) cai por hora.
  "stability": {
    "enabled": true,
    "baseline": 60,
    "popToStrength": 0.05,
    "garrisonPenalty": 25,
    "deficitPenalty": 15,
    "rebellionThreshold": 35,
    "graceHours": 48,
    "chancePerHour": 0.02,
    "rebelFaction": true,
    "unrestDecayPerHour": 0.5
  },
  // ---- M20: exército e recrutamento (ADR 0064) ----
  // Exércitos são ENTIDADES ABSTRATAS (Army.cpp); tropas, custo e tempo de treino por tipo ficam em Troops.json.
  // desertPerHour/deficitGraceHours: deserção por déficit de manutenção, como a guarnição (M14). aiUpkeep: false
  // = só facções do jogador pagam manutenção do exército (comida/ouro por soldado, Troops.json). Marcha entre
  // territórios vizinhos: hoursPer10000Units (70 unidades ≈ 1 m), entre minTravelHours e maxTravelHours.
  // maxOfficers/officerBonusEach: bônus de força simples por oficial (sem NPC por ora, ver ADR 0064).
  // maxEscort: teto GLOBAL de soldados em exércitos marcados para escoltar o jogador (M20: só contagem/teto;
  // seguimento físico é TODO, ver ADR 0064).
  "army": {
    "enabled": true,
    "desertPerHour": 0.1,
    "deficitGraceHours": 6,
    "aiUpkeep": false,
    "hoursPer10000Units": 2,
    "minTravelHours": 1,
    "maxTravelHours": 48,
    "maxOfficers": 3,
    "officerBonusEach": 0.1,
    "maxEscort": 6
  },
  // ---- M21: batalhas em tempo real (ADR 0065) ----
  // realTime: false = sempre resolução numérica (Ai::ResolveAttack / Army), nenhum ator é criado.
  // maxActors: teto GLOBAL de atores de batalha vivos no mundo (PRÓPRIO; não soma com garrison.maxActors).
  // spawnPerFrame: atores criados por frame (lotes encadeados via AddTask, como a guarnição). radius: distância
  // do jogador ao marcador do território para materializar e para continuar materializado (saiu = conclui a
  // batalha pela força restante). sideDistance/formationSpacing: formação simples (2-3 posições por lado).
  // randomness: só usado se o jogador abandona a área antes do fim (desfecho pela força restante, ± isto).
  // maxFrameMs: log de alerta se um lote de spawn passar disto.
  "battle": {
    "realTime": true,
    "maxActors": 10,
    "spawnPerFrame": 2,
    "radius": 4096,
    "sideDistance": 700,
    "formationSpacing": 180,
    "randomness": 0.15,
    "maxFrameMs": 2.0
  },
  "debug": {
    "enabled": true,
    "hotkey": 68,
    "selfTestHotkey": 87,
    "stockHotkey": 66,
    // Teclas (DIK): F10 alterna dono, F11 autoteste, F8 estoque, F3 claim, F4 simula conquista (F5/F9 são do jogo).
    "claimHotkey": 61,
    // M12/M13: F6 força economyHours horas de economia e mostra o resumo; F7 cria uma rota de teste.
    "economyHotkey": 64,
    "routeHotkey": 65,
    "economyHours": 24,
    "conquestHotkey": 62,
    // Reino (DIK): "-" resumo, "=" simula realmDebugHours horas, "[" próxima doutrina,
    // "]" entrega os realmConquerCount territórios mais próximos à facção do jogador.
    // (Antes eram NumPad1-4; trocado pra teclado sem teclado numérico — qualquer teclado tem essas teclas.)
    "realmHotkey": 12,
    "realmHoursHotkey": 13,
    "realmDoctrineHotkey": 26,
    "realmConquerHotkey": 27,
    "realmDebugHours": 24,
    "realmConquerCount": 5,
    // M11: "/" abre o mapa tático sem precisar da mesa de guerra (era NumPad9).
    "warMapHotkey": 53,
    // M14/M15: ";" mostra a guarnição do território atual e força o spawn perto do jogador (era NumPad5);
    // "'" inicia a próxima melhoria do território atual, ou da sede (era NumPad6). upgradeIgnoreCost: true = obra grátis.
    "garrisonHotkey": 39,
    "upgradeHotkey": 40,
    "upgradeIgnoreCost": false,
    // M16/M17: "," força o tick estratégico da IA e mostra os ataques (era NumPad7); "." alterna a relação da
    // sua facção com o dono do território atual — paz -> guerra -> trégua -> aliança (era NumPad8).
    "aiHotkey": 51,
    "diplomacyHotkey": 52,
    // M24: "\" força a oferta de governador na capital da província do território atual (era NumPad-).
    "jarlHotkey": 43,
    // M25/M26: F1 simula debugCaptureCount capturas no território atual; F2 resgata (ouro) o 1º prisioneiro
    // da sua facção; F12 executa o 1º prisioneiro; Delete mostra a estabilidade do território atual e força
    // uma checagem de rebelião imediata (era NumPad., decimal).
    "lawCaptureHotkey": 59,
    "lawRansomHotkey": 60,
    "lawExecuteHotkey": 88,
    "stabilityHotkey": 211,
    // M20/M21: Home recruta armyRecruitCount soldados no território atual da sua facção (era NumPad/); End
    // lista os seus exércitos (era NumPad*); Insert força uma batalha de teste (battleTestSize x
    // battleTestSize) perto do jogador (era NumPad+).
    // Teclas confirmadas em REX/W32/DINPUT.h (extern/CommonLibSSE-NG).
    "armyRecruitHotkey": 199,
    "armyListHotkey": 207,
    "battleTestHotkey": 210,
    "armyRecruitCount": 10,
    "battleTestSize": 6,
    "territory": "test_tower"
  }
}
