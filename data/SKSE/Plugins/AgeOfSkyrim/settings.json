{
  // "en", "pt-br" ou "auto" (idioma do jogo). textEncoding: "utf8" ou "cp1252" (se acentos aparecerem errados).
  "language": "pt-br",
  "textEncoding": "utf8",
  // Free Claim: objeto do estandarte (padrão: Iron Sword "fincada"), distância mínima entre claims
  // (unidades do jogo; 70 ≈ 1 m), máximo de claims, inclinação máxima do terreno e distância à frente.
  "claim": {
    "banner": "Skyrim.esm|0x012EB7",
    "minDistance": 2048,
    "maxClaims": 10,
    "maxSlopeDegrees": 35,
    "forwardDistance": 150
  },
  // Territórios descobertos dos locais do jogo (vanilla + mods) pelas keywords LocType*.
  // types: "fort", "camp", "village", "city" ("tower" só via JSON). exclude: ["Plugin.esp|0xID", ...].
  "discovery": {
    "enabled": true,
    "types": ["fort", "camp", "village", "city"],
    "exclude": [],
    "neighbors": 4
  },
  // ---- M5: conquista por local limpo (ADR 0022) ----
  // requirePlayerInLocation: false = vale também o local de onde o jogador acabou de sair.
  // onlyFromNeutral: true = não toma locais que já têm dono (ex.: deixar a Guerra Civil com outro mod).
  // exclude: ["Plugin.esp|0xID" (BGSLocation) ou "id_do_territorio"]; excludePlugins: ["MeuModDeGuerra.esp"].
  // defaultStyle/defaultColor: facção criada na primeira conquista se você ainda não tem uma ("" = automático).
  // M16: "skipCivilWarForts": true deixa os fortes da Guerra Civil de fora (também ligado pelo patch civil-war-mods;
  // se definido aqui, vence o patch).
  "conquest": {
    "enabled": true,
    "requirePlayerInLocation": true,
    "onlyFromNeutral": false,
    "exclude": [],
    "excludePlugins": [],
    "defaultStyle": "",
    "defaultColor": "#2E7D32"
  },
  // ---- M6: sede da facção (ADR 0023) ----
  // chest / warTable: "auto" (o DLL escolhe um baú vanilla SEM respawn e um ativador de mesa) ou "Plugin.esp|0xID".
  // Offsets [direita, frente, cima] relativos ao jogador no momento da fundação (sem coordenadas curadas ainda).
  "seat": {
    "askBeforeFounding": true,
    "chest": "auto",
    "warTable": "auto",
    "chestOffset": [-100, 150, 0],
    "warTableOffset": [120, 220, 0]
  },
  // ---- M16: facções de IA e contra-ataques (ADR 0047/0048) ----
  // tickHours: horas de jogo entre avaliações. A IA ataca vizinhos de facções em GUERRA com ela (diplomacia) e,
  // com expandIntoNeutral, territórios neutros dos expandTypes. Força do ataque = attackBase + ouro gasto /
  // goldPerStrength (gasta entre minGoldPerAttack e maxGoldPerAttack do saldo da facção); só lança se a força
  // >= defesa × minAdvantage. Defesa padrão por tipo (defenseByType; neutro × neutralDefenseMultiplier).
  // Marcha: hoursPer10000Units (70 unidades ≈ 1 m), entre minTravelHours e maxTravelHours.
  // respectConquestExclusions: a IA também não toca nos locais excluídos da conquista (settings + Compat/*.json).
  // skipCivilWarForts: fortes militares da Guerra Civil vanilla nunca são alvo da IA (também via Compat/*.json,
  // bloco "ai"; o valor daqui, se presente, vence o dos patches — por isso vem comentado).
  "ai": {
    "enabled": true,
    "tickHours": 6,
    "maxEvaluationsPerTick": 512,
    "maxActiveAttacks": 8,
    "maxAttacksPerFaction": 2,
    "cooldownHours": 24,
    "attackBase": 20,
    "goldPerStrength": 10,
    "minGoldPerAttack": 50,
    "maxGoldPerAttack": 500,
    "minAdvantage": 1.2,
    "randomness": 0.2,
    "hoursPer10000Units": 2,
    "minTravelHours": 2,
    "maxTravelHours": 48,
    "nearPlayerRadius": 8192,
    "attackPlayer": true,
    "expandIntoNeutral": true,
    "expandTypes": ["fort", "village", "city"],
    "neutralDefenseMultiplier": 0.5,
    "declareWarRatio": 2.0,
    "respectConquestExclusions": true,
    // "skipCivilWarForts": false,
    "defenseByType": { "fort": 40, "tower": 25, "camp": 15, "village": 15, "city": 60, "claim": 10, "unknown": 15 }
  },
  // ---- M17: diplomacia (ADR 0049) ----
  // Paz aceita depois de guerra = trégua de truceHours horas (sem guerra), depois paz. A IA aceita a paz se o
  // poder dela < o seu × peaceAcceptRatio (ou se está em déficit); aliança se você tem poder >= o dela ×
  // allianceAcceptRatio (e, com allianceNeedsCommonEnemy, um inimigo em comum). warOnConquest: tomar um território
  // de uma facção de IA que não está em guerra com você faz ela declarar guerra.
  "diplomacy": {
    "truceHours": 72,
    "peaceAcceptRatio": 1.5,
    "allianceAcceptRatio": 0.75,
    "allianceNeedsCommonEnemy": true,
    "warOnConquest": true
  },
  "debug": {
    "enabled": true,
    "hotkey": 68,
    "selfTestHotkey": 87,
    "stockHotkey": 66,
    // Teclas (DIK): F10 alterna dono, F11 autoteste, F8 estoque, F3 claim, F4 simula conquista (F5/F9 são do jogo).
    "claimHotkey": 61,
    // M12/M13: F6 força economyHours horas de economia e mostra o resumo; F7 cria uma rota de teste.
    "economyHotkey": 64,
    "routeHotkey": 65,
    "economyHours": 24,
    "conquestHotkey": 62,
    // M16/M17: NumPad7 força o tick estratégico da IA e mostra os ataques; NumPad8 alterna a relação da sua facção
    // com o dono do território atual (paz -> guerra -> trégua -> aliança).
    "aiHotkey": 71,
    "diplomacyHotkey": 72,
    "territory": "test_tower"
  }
}
